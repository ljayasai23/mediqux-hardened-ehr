# ==============================================================================
# MediQuX Backend Configuration Template
# HIPAA Security Rule Compliant Configuration
# NOTE: Do NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL 17)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediqux_db
DB_USER=mediqux_user
DB_PASSWORD=your_secure_db_password_here

# PostgreSQL Container Variables
POSTGRES_DB=mediqux_db
POSTGRES_USER=mediqux_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_PORT=5432

# Cryptographic Keys (HIPAA § 164.312(a)(1) & § 164.312(c)(1))
# Generate a cryptographically random 256-bit secret in production
JWT_SECRET=replace_with_cryptographically_secure_random_jwt_secret_key_minimum_32_chars
HMAC_SECRET=replace_with_cryptographically_secure_hmac_secret_for_data_integrity
