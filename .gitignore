# ==============================================================================
# MediQuX Git Ignore Configuration (HIPAA Hardened Edition)
# ==============================================================================

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dependencies
node_modules/
backend/node_modules/

# Environment & Secrets (NEVER commit secrets under PRD § 24)
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Runtime Logs & Audits
*.log
*.jsonl
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
backend/logs/*
!backend/logs/.gitkeep

# Uploads & User Generated PHI files
uploads/*
backend/uploads/*
!backend/uploads/.gitkeep

# Build & Test artifacts
/build
coverage/
.next/
.svelte-kit/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Runtime Generated Configs
frontend/js/runtime-config.js